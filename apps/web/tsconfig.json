{
  "extends": "@repo/ts-config/vite.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "*": ["./*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
