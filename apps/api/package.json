    "clean": "rm -rf dist .turbo node_modules/.tmp",
    "start": "bun dist/index.js"
  },
  "dependencies": {
    "@repo/shared": "workspace:*",
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/ts-config": "workspace:*",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
