{
  "name": "analy",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "bunx turbo --ui=tui dev --filter=web --filter=api --filter=@repo/shared",
    "dev:stream": "bunx turbo --ui=stream dev --filter=web --filter=api --filter=@repo/shared",
    "dev:web": "bunx turbo --ui=tui dev --filter=web",
    "dev:api": "bunx turbo --ui=tui dev --filter=api",
    "build": "bunx turbo build",
    "typecheck": "bunx turbo typecheck",
    "lint": "bunx turbo lint",
    "lint:staged": "lint-staged",
    "commitlint": "commitlint --edit",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:ps": "docker compose ps",
    "clean": "bunx turbo clean && rm -rf .turbo && find apps packages -name 'dist' -type d -prune -exec rm -rf {} + && find apps packages -name '*.tsbuildinfo' -type f -delete",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.15",
    "typescript": "^6.0.3"
  }
}
